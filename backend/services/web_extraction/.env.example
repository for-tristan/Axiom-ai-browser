# Task 3 – Web Extraction & Source Processing
# Copy this file to .env and adjust as needed.
# All values have sensible defaults — no configuration is required to run.

# ── Application ───────────────────────────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8003

# ── HTTP fetching ─────────────────────────────────────────────────────────
# Seconds before a single HTTP request is aborted.
REQUEST_TIMEOUT=15
# Maximum response body size in bytes (default 5 MB).
MAX_RESPONSE_SIZE=5242880
# Maximum simultaneous outgoing HTTP connections.
MAX_CONCURRENT_REQUESTS=10
# Maximum URLs accepted in a single API call.
MAX_URLS_PER_REQUEST=20

# ── Chunking ─────────────────────────────────────────────────────────────
# Target number of characters per RAG chunk.
CHUNK_SIZE=1000
# Overlap between consecutive chunks, in characters.
CHUNK_OVERLAP=200

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
